{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Ingestor of the technology-watch pipeline: polls RSS/Atom feeds and publishes\nevery new article on the NATS subject ARTICLES.ingested.\nErrors follow RFC 9457 (application/problem+json), see contracts/http-errors.md.",
        "title": "middleware/ingestor",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/articles": {
            "get": {
                "description": "What the ingestor has published on ARTICLES.ingested, most recent first: id,\nurls, source and date only. The content travels in the NATS message.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "articles"
                ],
                "summary": "Get the latest ingested articles.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Only the articles of this source (uuid)",
                        "name": "source_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "How many articles; all of them when left out",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.IngestedArticle"
                            }
                        }
                    },
                    "422": {
                        "description": "limit is not a number of 1 or more",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    },
                    "500": {
                        "description": "Something went wrong",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    }
                }
            }
        },
        "/articles/{id}": {
            "get": {
                "description": "Whether the ingestor has published this article, and from which source, when.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "articles"
                ],
                "summary": "Get an ingested article.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Article UUID (v5 of its canonical URL)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.IngestedArticle"
                        }
                    },
                    "404": {
                        "description": "Article not found",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    },
                    "422": {
                        "description": "Cannot parse id",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    },
                    "500": {
                        "description": "Something went wrong",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    }
                }
            }
        },
        "/sources": {
            "get": {
                "description": "Get every feed the ingestor knows.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sources"
                ],
                "summary": "Get all sources.",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Source"
                            }
                        }
                    },
                    "500": {
                        "description": "Something went wrong",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    }
                }
            },
            "post": {
                "description": "Add a feed to poll.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sources"
                ],
                "summary": "Create a source.",
                "parameters": [
                    {
                        "description": "The source",
                        "name": "source",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.Source"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.Source"
                        },
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "/sources/{id}"
                            }
                        }
                    },
                    "400": {
                        "description": "Body is not valid JSON",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    },
                    "409": {
                        "description": "A source with this id already exists",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    },
                    "422": {
                        "description": "A field is invalid",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    },
                    "500": {
                        "description": "Something went wrong",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    }
                }
            }
        },
        "/sources/{id}": {
            "get": {
                "description": "Get one feed.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sources"
                ],
                "summary": "Get a source.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Source id (uuid)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Source"
                        }
                    },
                    "404": {
                        "description": "Source not found",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    },
                    "422": {
                        "description": "A field is invalid",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    },
                    "500": {
                        "description": "Something went wrong",
                        "schema": {
                            "$ref": "#/definitions/models.Problem"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.IngestedArticle": {
            "type": "object",
            "properties": {
                "canonical_url": {
                    "type": "string"
                },
                "first_seen_at": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-09-13T15:07:02Z"
                },
                "id": {
                    "type": "string"
                },
                "source_id": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "models.Problem": {
            "type": "object",
            "properties": {
                "detail": {
                    "description": "what went wrong",
                    "type": "string"
                },
                "status": {
                    "description": "same number as the HTTP status code",
                    "type": "integer"
                },
                "title": {
                    "description": "standard phrase of the status, e.g. \"Not Found\"",
                    "type": "string"
                },
                "type": {
                    "description": "always \"about:blank\" in this TP",
                    "type": "string"
                }
            }
        },
        "models.Source": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        }
    }
}